{% extends 'public/client/layout.html.twig' %}

{% block client_content %}
<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header"><h5>Mes Rendez-vous</h5></div>
            <div class="card-body">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Heure</th>
                            <th>Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for rdv in appointments %}
                            <tr>
                                <td>{{ rdv.dateRdv|date('d/m/Y') }}</td>
                                <td>{{ rdv.plageHoraire.debut }}</td>
                                <td><span class="badge bg-info">{{ rdv.statut.value }}</span></td>
                            </tr>
                        {% else %}
                            <tr><td colspan="3">Aucun rendez-vous</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header"><h5>Mes Animaux</h5></div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    {% for animal in animals %}
                        <li class="list-group-item">{{ animal.nom }} ({{ animal.espece }})</li>
                    {% else %}
                        <li class="list-group-item">Aucun animal enregistré</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
</div>
{% endblock %}
