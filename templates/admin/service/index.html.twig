{% extends 'admin/layout.html.twig' %}

{% block title %}Catalogue des Services{% endblock %}

{% block body %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">
                    Catalogue des Services
                </h2>
            </div>
            <div class="col-auto ms-auto d-print-none">
                <div class="btn-list">
                    <a href="{{ path('admin_service_categorie_index') }}" class="btn btn-secondary">
                        Gérer les catégories
                    </a>
                    <a href="{{ path('admin_service_new') }}" class="btn btn-primary d-none d-sm-inline-block">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 5l0 14" /><path d="M5 12l14 0" /></svg>
                        Nouveau Service
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Service</th>
                            <th>Catégorie</th>
                            <th>Durée</th>
                            <th>Tarif</th>
                            <th>Statut</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for service in services %}
                            <tr>
                                <td><span class="badge bg-blue-lt">{{ service.code }}</span></td>
                                <td>
                                    <a href="{{ path('admin_service_show', {id: service.id}) }}">{{ service.nom }}</a>
                                    <div class="text-secondary small">{{ service.description|slice(0, 50) }}...</div>
                                </td>
                                <td>{{ service.categorie.nom }}</td>
                                <td>{{ service.dureeDefaultMinutes }} min</td>
                                <td>{{ service.tarif.montant }} {{ service.tarif.devise }}</td>
                                <td>
                                    {% if service.isActif %}
                                        <span class="badge bg-success">Actif</span>
                                    {% else %}
                                        <span class="badge bg-danger">Inactif</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="btn-list flex-nowrap">
                                        <a href="{{ path('admin_service_show', {id: service.id}) }}" class="btn btn-white btn-sm">Détail</a>
                                        <a href="{{ path('admin_service_edit', {id: service.id}) }}" class="btn btn-white btn-sm">Modifier</a>
                                        <form method="post" action="{{ path('admin_service_delete', {id: service.id}) }}" onsubmit="return confirm('Êtes-vous sûr ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ service.id) }}">
                                            <button class="btn btn-danger btn-sm">Supprimer</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center">Aucun service trouvé</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
