{% extends 'admin/layout.html.twig' %}

{% block title %}Catalogue des Services{% endblock %}

{% block body %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-3 align-items-center">
            <div class="col">
                <h2 class="page-title">
                    <i class="ti ti-list-check me-2"></i>Catalogue des Services
                </h2>
            </div>
            <div class="col-auto">
                <div class="btn-list">
                    <a href="{{ path('admin_service_categorie_index') }}" class="btn btn-secondary">
                        <i class="ti ti-category me-2"></i>Gérer les catégories
                    </a>
                    <a href="{{ path('admin_service_new') }}" class="btn btn-primary">
                        <i class="ti ti-plus me-2"></i>Nouveau Service
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <!-- Header avec recherche -->
            <div class="card-header">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="ti ti-search"></i>
                            </span>
                            <input type="text" id="search" class="form-control" 
                                   placeholder="Rechercher par code, nom, catégorie...">
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover" id="servicesTable">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Service</th>
                            <th>Catégorie</th>
                            <th>Durée</th>
                            <th>Tarif</th>
                            <th>Statut</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for service in services %}
                            <tr>
                                <td>
                                    <span class="badge bg-blue-lt">{{ service.code }}</span>
                                </td>
                                <td>
                                    <a href="{{ path('admin_service_show', {id: service.id}) }}" class="text-blue">
                                        <strong>{{ service.nom }}</strong>
                                    </a>
                                    {% if service.description %}
                                        <div class="text-secondary small mt-1">
                                            {{ service.description|slice(0, 60) }}{% if service.description|length > 60 %}...{% endif %}
                                        </div>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge bg-secondary">{{ service.categorie.nom }}</span>
                                </td>
                                <td>{{ service.dureeDefaultMinutes }} min</td>
                                <td>
                                    <strong>{{ service.tarif.montant }} {{ service.tarif.devise }}</strong>
                                </td>
                                <td>
                                    {% if service.isActif %}
                                        <span class="badge bg-success">
                                            <i class="ti ti-check me-1"></i>Actif
                                        </span>
                                    {% else %}
                                        <span class="badge bg-danger">
                                            <i class="ti ti-x me-1"></i>Inactif
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    <div class="btn-list justify-content-end">
                                        <a href="{{ path('admin_service_show', {id: service.id}) }}" 
                                           class="btn btn-sm btn-icon btn-white" title="Voir détail">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        <a href="{{ path('admin_service_edit', {id: service.id}) }}" 
                                           class="btn btn-sm btn-icon btn-white" title="Modifier">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                        <form method="post" 
                                              action="{{ path('admin_service_delete', {id: service.id}) }}" 
                                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce service ?');"
                                              style="display: inline;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ service.id) }}">
                                            <button type="submit" class="btn btn-sm btn-icon btn-danger" title="Supprimer">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <i class="ti ti-list-check text-muted" style="font-size: 3.5rem;"></i>
                                    <p class="text-muted mt-3">Aucun service trouvé</p>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('search');
    const tableRows = document.querySelectorAll('#servicesTable tbody tr');

    function filterTable() {
        const searchTerm = searchInput.value.toLowerCase().trim();

        tableRows.forEach(row => {
            if (row.cells.length < 6) return; // Ignorer ligne vide

            const code = row.cells[0].textContent.toLowerCase();
            const service = row.cells[1].textContent.toLowerCase();
            const categorie = row.cells[2].textContent.toLowerCase();

            const matchesSearch = code.includes(searchTerm) || 
                                  service.includes(searchTerm) || 
                                  categorie.includes(searchTerm);

            row.style.display = matchesSearch ? '' : 'none';
        });
    }

    searchInput.addEventListener('keyup', filterTable);
});
</script>
{% endblock %}