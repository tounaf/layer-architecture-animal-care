{% extends 'admin/layout.html.twig' %}

{% block page_title %}Tableau de Bord Administratif{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-xxl-3 col-md-6">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h5 class="text-muted fs-13 text-uppercase">Total Utilisateurs</h5>
                            <h3 class="mb-0 fw-bold">1,245</h3>
                        </div>
                        <div class="avatar-md flex-shrink-0">
                            <span class="avatar-title bg-primary-subtle text-primary rounded-circle fs-22">
                                <i class="ti ti-users"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-xxl-3 col-md-6">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h5 class="text-muted fs-13 text-uppercase">Rendez-vous à venir</h5>
                            <h3 class="mb-0 fw-bold">42</h3>
                        </div>
                        <div class="avatar-md flex-shrink-0">
                            <span class="avatar-title bg-success-subtle text-success rounded-circle fs-22">
                                <i class="ti ti-calendar"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header border-bottom border-dashed d-flex align-items-center">
                    <h4 class="header-title flex-grow-1">Bienvenue dans l'administration</h4>
                </div>
                <div class="card-body">
                    <p>Ceci est votre nouveau tableau de bord utilisant le template Osen intégré avec succès.</p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
