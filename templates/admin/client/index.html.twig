{% extends 'admin/layout.html.twig' %}

{% block title %}Gestion des Clients{% endblock %}

{% block body %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-3 align-items-center">
            <div class="col">
                <h2 class="page-title">
                    <i class="ti ti-users me-2"></i>Clients
                </h2>
            </div>
            <div class="col-auto">
                <a href="{{ path('admin_client_new') }}" class="btn btn-primary">
                    <i class="ti ti-plus me-2"></i>Nouveau Client
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <!-- Header avec recherche -->
            <div class="card-header">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="ti ti-search"></i>
                            </span>
                            <input type="text" id="search" class="form-control" placeholder="Rechercher un client (nom, email, téléphone...)">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <!-- Tu peux ajouter un filtre par ville plus tard si besoin -->
                        <select id="villeFilter" class="form-select">
                            <option value="">Toutes les villes</option>
                            <!-- Les options peuvent être remplies dynamiquement si tu veux -->
                        </select>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover" id="clientsTable">
                    <thead>
                        <tr>
                            <th>Nom Complet</th>
                            <th>Email</th>
                            <th>Téléphone</th>
                            <th>Ville</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for client in clients %}
                            <tr>
                                <td>
                                    <strong>{{ client.nom }} {{ client.prenom }}</strong>
                                </td>
                                <td>
                                    <a href="mailto:{{ client.email }}" class="text-blue">
                                        {{ client.email }}
                                    </a>
                                </td>
                                <td>{{ client.telephone }}</td>
                                <td>
                                    <span class="badge bg-secondary">{{ client.ville|default('Non renseignée') }}</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-list justify-content-end">
                                        <a href="{{ path('admin_client_edit', {id: client.id}) }}" 
                                           class="btn btn-sm btn-icon btn-white" 
                                           title="Modifier">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                        <form method="post" 
                                              action="{{ path('admin_client_delete', {id: client.id}) }}" 
                                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce client ? Cette action est irréversible.');"
                                              style="display: inline;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ client.id) }}">
                                            <button type="submit" class="btn btn-sm btn-icon btn-danger" title="Supprimer">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <i class="ti ti-users text-muted" style="font-size: 3.5rem;"></i>
                                    <p class="text-muted mt-3 mb-0">Aucun client trouvé</p>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('search');
    const tableRows = document.querySelectorAll('#clientsTable tbody tr');

    function filterTable() {
        const searchTerm = searchInput.value.toLowerCase().trim();

        tableRows.forEach(row => {
            // Ignorer la ligne "Aucun client trouvé"
            if (row.cells.length < 4) return;

            const nom = row.cells[0].textContent.toLowerCase();
            const email = row.cells[1].textContent.toLowerCase();
            const telephone = row.cells[2].textContent.toLowerCase();
            const ville = row.cells[3].textContent.toLowerCase();

            const matchesSearch = nom.includes(searchTerm) || 
                                  email.includes(searchTerm) || 
                                  telephone.includes(searchTerm) || 
                                  ville.includes(searchTerm);

            row.style.display = matchesSearch ? '' : 'none';
        });
    }

    searchInput.addEventListener('keyup', filterTable);
});
</script>
{% endblock %}