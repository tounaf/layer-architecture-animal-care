{% extends 'admin/layout.html.twig' %}

{% block title %}Détails du Client{% endblock %}

{% block body %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">{{ client.nom }} {{ client.prenom }}</h2>
            </div>
            <div class="col-auto ms-auto">
                <a href="{{ path('admin_client_edit', {id: client.id}) }}" class="btn btn-primary">Modifier</a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="row row-cards">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <div class="datagrid">
                            <div class="datagrid-item">
                                <div class="datagrid-title">Email</div>
                                <div class="datagrid-content">{{ client.email }}</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Téléphone</div>
                                <div class="datagrid-content">{{ client.telephone|default('-') }}</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Ville</div>
                                <div class="datagrid-content">{{ client.ville|default('-') }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Animaux du client</h3></div>
                    <div class="table-responsive">
                        <table class="table table-vcenter card-table">
                            <thead>
                                <tr>
                                    <th>Nom</th>
                                    <th>Espèce / Race</th>
                                    <th>Poids</th>
                                    <th class="w-1"></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for animal in animals %}
                                    <tr>
                                        <td>{{ animal.nom }}</td>
                                        <td>{{ animal.espece }} / {{ animal.race }}</td>
                                        <td>{{ animal.poids }} kg</td>
                                        <td><a href="{{ path('admin_animal_show', {id: animal.id}) }}">Détail</a></td>
                                    </tr>
                                {% else %}
                                    <tr><td colspan="4" class="text-center">Aucun animal</td></tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
