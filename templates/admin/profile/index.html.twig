{% extends 'admin/layout.html.twig' %}

{% block title %}Gestion des profils{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="card-title">Profils</h4>
            <a href="{{ path('admin_profile_new') }}" class="btn btn-primary">Nouveau profil</a>
        </div>
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Droits</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for profile in profiles %}
                    <tr>
                        <td>{{ profile.profileName }}</td>
                        <td>
                            {% for right in profile.rights %}
                                <span class="badge bg-info">{{ right.rightName }}</span>
                            {% endfor %}
                        </td>
                        <td>
                            <div class="btn-group">
                                <a href="{{ path('admin_profile_show', {'id': profile.id}) }}" class="btn btn-sm btn-info">Détails</a>
                                <a href="{{ path('admin_profile_edit', {'id': profile.id}) }}" class="btn btn-sm btn-warning">Editer</a>
                                <form method="post" action="{{ path('admin_profile_delete', {'id': profile.id}) }}" onsubmit="return confirm('Supprimer ?');" style="display:inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ profile.id) }}">
                                    <button class="btn btn-sm btn-danger">Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
