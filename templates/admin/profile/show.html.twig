{% extends 'admin/layout.html.twig' %}
{% block title %}Détails profil{% endblock %}
{% block body %}
<div class="container-fluid">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="card-title">Détails : {{ profile.profileName }}</h4>
            <a href="{{ path('admin_profile_index') }}" class="btn btn-secondary">Retour</a>
        </div>
        <div class="card-body">
            <p><strong>ID :</strong> {{ profile.id }}</p>
            <h5>Droits associés</h5>
            <ul>
                {% for right in profile.rights %}<li>{{ right.rightName }} ({{ right.rightCode }})</li>{% endfor %}
            </ul>
        </div>
    </div>
</div>
{% endblock %}
