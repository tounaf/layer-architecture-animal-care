<!-- Topbar Start -->
<header class="app-topbar">
    <div class="page-container topbar-menu">
        <div class="d-flex align-items-center gap-2">

            <!-- Brand Logo -->
            <a href="{{ path('admin_dashboard') }}" class="logo">
                <span class="logo-light">
                    <span class="logo-lg"><img src="{{ asset('admin-assets/images/logo.png') }}" alt="logo"></span>
                    <span class="logo-sm"><img src="{{ asset('admin-assets/images/logo-sm.png') }}" alt="small logo"></span>
                </span>

                <span class="logo-dark">
                    <span class="logo-lg"><img src="{{ asset('admin-assets/images/logo-dark.png') }}" alt="dark logo"></span>
                    <span class="logo-sm"><img src="{{ asset('admin-assets/images/logo-sm.png') }}" alt="small logo"></span>
                </span>
            </a>

            <!-- Sidebar Menu Toggle Button -->
            <button class="sidenav-toggle-button px-2">
                <i class="ti ti-menu-deep fs-24"></i>
            </button>

            <!-- Horizontal Menu Toggle Button -->
            <button class="topnav-toggle-button px-2" data-bs-toggle="collapse" data-bs-target="#topnav-menu-content">
                <i class="ti ti-menu-deep fs-22"></i>
            </button>

            <!-- LEFT SLOT DYNAMIQUE -->
            {% for item in topbar_registry.getItemsBySlot('left') %}
                {% if item.hasTemplate() %}
                    {% include item.template with item.templateData %}
                {% else %}
                    <div 
                        {% for attr, val in item.attributes %} {{ attr }}="{{ val }}" {% endfor %}
                        {% if item.routeName %} onclick="location.href='{{ path(item.routeName) }}'" style="cursor:pointer;" {% endif %}
                    >
                        {% if item.icon %}<i class="{{ item.icon }}"></i>{% endif %}
                        <span class="me-2">{{ item.label }}</span>
                        {% if '⌘K' in item.label or item.label == 'Search' %}<span class="ms-auto fw-medium">⌘K</span>{% endif %}
                    </div>
                {% endif %}
            {% endfor %}
        </div>

        <div class="d-flex align-items-center gap-2">

            <!-- RIGHT SLOT DYNAMIQUE -->
            {% for item in topbar_registry.getItemsBySlot('right') %}
                {% if item.hasTemplate() %}
                    {% include item.template with item.templateData %}
                {% else %}
                    <div class="topbar-item">
                        <button 
                            {% for attr, val in item.attributes %} {{ attr }}="{{ val }}" {% endfor %}
                            {% if item.routeName %} onclick="location.href='{{ path(item.routeName) }}'" {% endif %}
                        >
                            {% if item.icon %}<i class="{{ item.icon }}"></i>{% endif %}
                        </button>
                    </div>
                {% endif %}
            {% endfor %}

            <!-- User Dropdown (PARTIELLEMENT DYNAMIQUE) -->
            <div class="topbar-item nav-user">
                <div class="dropdown">
                    <a class="topbar-link dropdown-toggle drop-arrow-none px-2" data-bs-toggle="dropdown" data-bs-offset="0,19" type="button" aria-haspopup="false" aria-expanded="false">
                        <img src="{{ asset('admin-assets/images/users/avatar-1.jpg') }}" width="32" class="rounded-circle me-lg-2 d-flex" alt="user-image">
                        <span class="d-lg-flex flex-column gap-1 d-none">
                            <h5 class="my-0">Utilisateur</h5>
                            <h6 class="my-0 fw-normal">Admin</h6>
                        </span>
                        <i class="ti ti-chevron-down d-none d-lg-block align-middle ms-2"></i>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end">
                        <div class="dropdown-header noti-title">
                            <h6 class="text-overflow m-0">Bienvenue !</h6>
                        </div>

                        <!-- USER_MENU SLOT DYNAMIQUE -->
                        {% for item in topbar_registry.getItemsBySlot('user_menu') %}
                            <a href="{{ item.routeName ? path(item.routeName) : 'javascript:void(0);' }}" class="dropdown-item">
                                {% if item.icon %}<i class="{{ item.icon }} me-1 fs-17 align-middle"></i>{% endif %}
                                <span class="align-middle">{{ item.label }}</span>
                            </a>
                        {% endfor %}

                        <div class="dropdown-divider"></div>

                        <a href="#" class="dropdown-item active fw-semibold text-danger">
                            <i class="ti ti-logout me-1 fs-17 align-middle"></i>
                            <span class="align-middle">Déconnexion</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>
