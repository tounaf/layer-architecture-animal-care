{% extends 'admin/layout.html.twig' %}

{% block title %}Détails de la Catégorie{% endblock %}

{% block body %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Catégorie : {{ categorie.nom }}</h2>
            </div>
            <div class="col-auto ms-auto">
                <a href="{{ path('admin_service_categorie_edit', {id: categorie.id}) }}" class="btn btn-primary">Modifier</a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="card-body">
                <div class="datagrid">
                    <div class="datagrid-item">
                        <div class="datagrid-title">Icône</div>
                        <div class="datagrid-content"><i class="{{ categorie.icone }}"></i> {{ categorie.icone }}</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Ordre d'affichage</div>
                        <div class="datagrid-content">{{ categorie.ordreAffichage }}</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Statut</div>
                        <div class="datagrid-content">
                            {% if categorie.isActif %}
                                <span class="status status-green">Actif</span>
                            {% else %}
                                <span class="status status-red">Inactif</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="datagrid mt-4">
                    <div class="datagrid-item">
                        <div class="datagrid-title">Description</div>
                        <div class="datagrid-content">{{ categorie.description|default('Aucune description') }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
