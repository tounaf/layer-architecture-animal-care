{% extends 'admin/layout.html.twig' %}

{% block title %}Catégories de Services{% endblock %}

{% block body %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-3 align-items-center">
            <div class="col">
                <h2 class="page-title">
                    <i class="ti ti-category me-2"></i>Catégories de Services
                </h2>
            </div>
            <div class="col-auto">
                <a href="{{ path('admin_service_categorie_new') }}" class="btn btn-primary">
                    <i class="ti ti-plus me-2"></i>Nouvelle Catégorie
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <!-- Header avec recherche -->
            <div class="card-header">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="ti ti-search"></i>
                            </span>
                            <input type="text" id="search" class="form-control" 
                                   placeholder="Rechercher une catégorie...">
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover" id="categoriesTable">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Ordre</th>
                            <th style="width: 70px;">Icône</th>
                            <th>Nom</th>
                            <th>Description</th>
                            <th>Statut</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for categorie in categories %}
                            <tr>
                                <td>
                                    <strong>{{ categorie.ordreAffichage }}</strong>
                                </td>
                                <td>
                                    <i class="{{ categorie.icone }} fs-3" style="color: #206bc4;"></i>
                                </td>
                                <td>
                                    <strong>{{ categorie.nom }}</strong>
                                </td>
                                <td class="text-secondary">
                                    {{ categorie.description|default('<span class="text-muted">Aucune description</span>')|raw }}
                                </td>
                                <td>
                                    {% if categorie.isActif %}
                                        <span class="badge bg-success">
                                            <i class="ti ti-check me-1"></i>Actif
                                        </span>
                                    {% else %}
                                        <span class="badge bg-danger">
                                            <i class="ti ti-x me-1"></i>Inactif
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    <div class="btn-list justify-content-end">
                                        <a href="{{ path('admin_service_categorie_edit', {id: categorie.id}) }}" 
                                           class="btn btn-sm btn-icon btn-white" title="Modifier">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                        <form method="post" 
                                              action="{{ path('admin_service_categorie_delete', {id: categorie.id}) }}" 
                                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette catégorie ?');"
                                              style="display: inline;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ categorie.id) }}">
                                            <button type="submit" class="btn btn-sm btn-icon btn-danger" title="Supprimer">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <i class="ti ti-category text-muted" style="font-size: 3.5rem;"></i>
                                    <p class="text-muted mt-3">Aucune catégorie trouvée</p>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('search');
    const tableRows = document.querySelectorAll('#categoriesTable tbody tr');

    function filterTable() {
        const searchTerm = searchInput.value.toLowerCase().trim();

        tableRows.forEach(row => {
            if (row.cells.length < 5) return;

            const nom = row.cells[2].textContent.toLowerCase();
            const description = row.cells[3].textContent.toLowerCase();

            const matchesSearch = nom.includes(searchTerm) || description.includes(searchTerm);

            row.style.display = matchesSearch ? '' : 'none';
        });
    }

    searchInput.addEventListener('keyup', filterTable);
});
</script>
{% endblock %}