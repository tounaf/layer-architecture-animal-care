{% extends 'auth/layout.html.twig' %}

{% block auth_content %}
    <h3 class="fw-semibold mb-2">Connectez-vous</h3>
    <p class="text-muted mb-4">Entrez votre email et votre mot de passe pour accéder au panel.</p>

    {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <div class="d-flex justify-content-center gap-2 mb-3">
        <a href="#!" class="btn btn-soft-danger avatar-lg"><i class="ti ti-brand-google-filled fs-24"></i></a>
        <a href="#!" class="btn btn-soft-success avatar-lg"><i class="ti ti-brand-apple fs-24"></i></a>
        <a href="#!" class="btn btn-soft-primary avatar-lg"><i class="ti ti-brand-facebook fs-24"></i></a>
    </div>

    <p class="fs-13 fw-semibold">Ou utilisez votre Email</p>

    <form method="post" class="text-start mb-3">
        <div class="mb-3">
            <label for="username" class="form-label">Email</label>
            <input type="email" value="{{ last_username|default('') }}" name="_username" id="username" class="form-control" placeholder="votre@email.com" required autofocus>
        </div>
        <div class="mb-3">
            <label for="password" class="form-label">Mot de passe</label>
            <input type="password" name="_password" id="password" class="form-control" placeholder="Mot de passe" required>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div class="d-flex justify-content-between mb-3">
            <div class="form-check">
                <input type="checkbox" name="_remember_me" id="remember_me" class="form-check-input">
                <label for="remember_me" class="form-check-label">Se souvenir de moi</label>
            </div>
            <a href="#" class="text-muted border-bottom border-dashed">Mot de passe oublié ?</a>
        </div>

        <div class="d-grid">
            <button class="btn btn-primary" type="submit">Se connecter</button>
        </div>
    </form>

    <p class="text-danger fs-14 mb-4">Pas encore de compte ? <a href="#" class="fw-semibold text-dark ms-1">S'inscrire !</a></p>
{% endblock %}
