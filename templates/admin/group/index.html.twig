{% extends 'admin/layout.html.twig' %}

{% block title %}Gestion des groupes{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="card-title">Groupes</h4>
            <a href="{{ path('admin_group_new') }}" class="btn btn-primary">Nouveau groupe</a>
        </div>
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Profils</th>
                        <th>Droits</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for group in groups %}
                    <tr>
                        <td>{{ group.groupName }}</td>
                        <td>
                            {% for profile in group.profiles %}
                                <span class="badge bg-secondary">{{ profile.profileName }}</span>
                            {% endfor %}
                        </td>
                        <td>
                            {% for right in group.rights %}
                                <span class="badge bg-info">{{ right.rightName }}</span>
                            {% endfor %}
                        </td>
                        <td>
                            <div class="btn-group">
                                <a href="{{ path('admin_group_show', {'id': group.id}) }}" class="btn btn-sm btn-info">Détails</a>
                                <a href="{{ path('admin_group_edit', {'id': group.id}) }}" class="btn btn-sm btn-warning">Editer</a>
                                <form method="post" action="{{ path('admin_group_delete', {'id': group.id}) }}" onsubmit="return confirm('Supprimer ?');" style="display:inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ group.id) }}">
                                    <button class="btn btn-sm btn-danger">Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
