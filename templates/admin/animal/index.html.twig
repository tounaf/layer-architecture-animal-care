{% extends 'admin/layout.html.twig' %}

{% block title %}Gestion des Animaux{% endblock %}

{% block body %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Animaux</h2>
            </div>
            <div class="col-auto ms-auto">
                <a href="{{ path('admin_animal_new') }}" class="btn btn-primary">
                    Nouveau Animal
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Espèce / Race</th>
                            <th>Date de Naissance</th>
                            <th>Poids (kg)</th>
                            <th>Propriétaire</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in enhancedAnimals %}
                            {% set animal = item.animal %}
                            <tr>
                                <td>{{ animal.nom }}</td>
                                <td>{{ animal.espece ?: 'N/A' }} / {{ animal.race ?: 'N/A' }}</td>
                                <td>{{ animal.dateNaissance ? animal.dateNaissance|date('d/m/Y') : '-' }}</td>
                                <td>{{ animal.poids ?: '-' }}</td>
                                <td>{{ item.proprietaireName }}</td>
                                <td>
                                    <div class="btn-list flex-nowrap">
                                        <a href="{{ path('admin_animal_show', {id: animal.id}) }}" class="btn btn-white btn-sm">Détails</a>
                                        <a href="{{ path('admin_animal_edit', {id: animal.id}) }}" class="btn btn-white btn-sm">Modifier</a>
                                        <form method="post" action="{{ path('admin_animal_delete', {id: animal.id}) }}" onsubmit="return confirm('Êtes-vous sûr ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ animal.id) }}">
                                            <button class="btn btn-danger btn-sm">Supprimer</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="6" class="text-center">Aucun animal trouvé</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
