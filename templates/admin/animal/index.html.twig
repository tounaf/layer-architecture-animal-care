{% extends 'admin/layout.html.twig' %}

{% block title %}Gestion des Animaux{% endblock %}

{% block body %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-3 align-items-center">
            <div class="col">
                <h2 class="page-title">
                    <i class="ti ti-paw me-2"></i>Animaux
                </h2>
            </div>
            <div class="col-auto">
                <a href="{{ path('admin_animal_new') }}" class="btn btn-primary">
                    <i class="ti ti-plus me-2"></i>Nouveau Animal
                </a>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <!-- Header avec recherche -->
            <div class="card-header">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="ti ti-search"></i>
                            </span>
                            <input type="text" id="search" class="form-control" 
                                   placeholder="Rechercher par nom, espèce, race, propriétaire...">
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover" id="animauxTable">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Espèce / Race</th>
                            <th>Date de Naissance</th>
                            <th>Poids (kg)</th>
                            <th>Propriétaire</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in enhancedAnimals %}
                            {% set animal = item.animal %}
                            <tr>
                                <td><strong>{{ animal.nom }}</strong></td>
                                <td>
                                    {{ animal.espece ?: 'N/A' }} 
                                    <span class="text-muted">/ {{ animal.race ?: 'N/A' }}</span>
                                </td>
                                <td>
                                    {{ animal.dateNaissance ? animal.dateNaissance|date('d/m/Y') : '-' }}
                                </td>
                                <td>
                                    {% if animal.poids %}
                                        {{ animal.poids }} kg
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td>{{ item.proprietaireName }}</td>
                                <td class="text-end">
                                    <div class="btn-list justify-content-end">
                                        <!-- Détails -->
                                        <a href="{{ path('admin_animal_show', {id: animal.id}) }}" 
                                           class="btn btn-sm btn-icon btn-white" 
                                           title="Voir détails">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        <!-- Modifier -->
                                        <a href="{{ path('admin_animal_edit', {id: animal.id}) }}" 
                                           class="btn btn-sm btn-icon btn-white" 
                                           title="Modifier">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                        <!-- Supprimer -->
                                        <form method="post" 
                                              action="{{ path('admin_animal_delete', {id: animal.id}) }}" 
                                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet animal ? Cette action est irréversible.');"
                                              style="display: inline;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ animal.id) }}">
                                            <button type="submit" class="btn btn-sm btn-icon btn-danger" title="Supprimer">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <i class="ti ti-paw text-muted" style="font-size: 3.5rem;"></i>
                                    <p class="text-muted mt-3 mb-0">Aucun animal trouvé</p>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('search');
    const tableRows = document.querySelectorAll('#animauxTable tbody tr');

    function filterTable() {
        const searchTerm = searchInput.value.toLowerCase().trim();

        tableRows.forEach(row => {
            if (row.cells.length < 5) return; // Ignorer la ligne vide

            const nom = row.cells[0].textContent.toLowerCase();
            const especeRace = row.cells[1].textContent.toLowerCase();
            const proprietaire = row.cells[4].textContent.toLowerCase();

            const matchesSearch = nom.includes(searchTerm) || 
                                  especeRace.includes(searchTerm) || 
                                  proprietaire.includes(searchTerm);

            row.style.display = matchesSearch ? '' : 'none';
        });
    }

    searchInput.addEventListener('keyup', filterTable);
});
</script>
{% endblock %}