{% extends 'admin/layout.html.twig' %}

{% block title %}Détails de {{ animal.nom }}{% endblock %}

{% block body %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-3 align-items-center">
            <div class="col">
                <div class="d-flex align-items-center">
                    <i class="ti ti-paw me-3 text-primary" style="font-size: 2rem;"></i>
                    <div>
                        <h2 class="page-title mb-0">{{ animal.nom }}</h2>
                        <p class="text-muted mb-0">
                            {{ animal.espece ?: 'Animal' }} • {{ animal.race ?: 'Race non renseignée' }}
                        </p>
                    </div>
                </div>
            </div>
            
            <div class="col-auto">
                <div class="btn-list">
                    <a href="{{ path('admin_animal_index') }}" class="btn btn-secondary">
                        <i class="ti ti-arrow-left me-2"></i>Retour à la liste
                    </a>
                    <a href="{{ path('admin_animal_edit', {id: animal.id}) }}" class="btn btn-primary">
                        <i class="ti ti-edit me-2"></i>Modifier
                    </a>
                    <form method="post" 
                          action="{{ path('admin_animal_delete', {id: animal.id}) }}" 
                          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet animal ? Cette action est irréversible.');"
                          style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ animal.id) }}">
                        <button type="submit" class="btn btn-danger">
                            <i class="ti ti-trash me-2"></i>Supprimer
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <!-- Colonne principale des informations -->
                    <div class="col-lg-8">
                        <h3 class="card-title mb-4">Informations générales</h3>
                        
                        <div class="datagrid">
                            <div class="datagrid-item">
                                <div class="datagrid-title">Espèce</div>
                                <div class="datagrid-content">
                                    <strong>{{ animal.espece ?: 'Non renseignée' }}</strong>
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Race</div>
                                <div class="datagrid-content">{{ animal.race ?: 'Non renseignée' }}</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Date de Naissance</div>
                                <div class="datagrid-content">
                                    {{ animal.dateNaissance ? animal.dateNaissance|date('d/m/Y') : 'Non renseignée' }}
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Poids</div>
                                <div class="datagrid-content">
                                    {% if animal.poids %}
                                        <strong>{{ animal.poids }} kg</strong>
                                    {% else %}
                                        Non renseigné
                                    {% endif %}
                                </div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Propriétaire</div>
                                <div class="datagrid-content">
                                    <a href="#" class="text-blue">{{ proprietaireInfo }}</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Colonne latérale (peut servir pour photo ou infos rapides) -->
                    <div class="col-lg-4">
                        <div class="text-center mb-4">
                            <div class="avatar avatar-xl mb-3 bg-blue-lt" style="width: 120px; height: 120px; font-size: 3rem;">
                                <i class="ti ti-paw"></i>
                            </div>
                            <h4 class="mb-1">{{ animal.nom }}</h4>
                            <span class="badge bg-primary">
                                {{ animal.espece ?: 'Animal' }}
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}