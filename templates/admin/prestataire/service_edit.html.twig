{% extends 'admin/layout.html.twig' %}

{% block title %}Modifier le service proposé{% endblock %}

{% block body %}
<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="card-header"><h3 class="card-title">Modifier le service proposé</h3></div>
            <div class="card-body">
                {{ form_start(form) }}
                    {{ form_widget(form) }}
                    <div class="form-footer">
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                        <a href="{{ path('admin_prestataire_show', {id: servicePropose.prestataireId}) }}" class="btn btn-link">Annuler</a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
