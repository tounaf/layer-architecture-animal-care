{% extends 'admin/layout.html.twig' %}
{% block title %}Modifier droit{% endblock %}
{% block body %}
<div class="container-fluid">
    <div class="card">
        <div class="card-header"><h4 class="card-title">Modifier : {{ right.rightName }}</h4></div>
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_row(form.rightName) }}
                {{ form_row(form.rightCode) }}
                <button class="btn btn-primary mt-3">Enregistrer</button>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
