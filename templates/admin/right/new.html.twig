{% extends 'admin/layout.html.twig' %}
{% block title %}Nouveau droit{% endblock %}
{% block body %}
<div class="container-fluid">
    <div class="card">
        <div class="card-header"><h4 class="card-title">Nouveau droit</h4></div>
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_row(form.rightName) }}
                {{ form_row(form.rightCode) }}
                <button class="btn btn-success mt-3">Créer</button>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
