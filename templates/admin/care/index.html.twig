{% extends 'admin/layout.html.twig' %}

{% block title %}Carnet de Santé{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title">Suivi Médical (CARE)</h4>
                </div>
                <div class="card-body">
                    <p>Interface de gestion des carnets de santé.</p>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Animal</th>
                                <th>Client (Propriétaire)</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in enhancedCarnets %}
                                <tr>
                                    <td>{{ item.animalName }}</td>
                                    <td>{{ item.clientName }}</td>
                                    <td>
                                        {# Pour l'instant pas de vue de détail implémentée, mais on pourrait #}
                                        <button class="btn btn-sm btn-info">Voir l'historique</button>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="3" class="text-center">Aucun carnet de santé trouvé</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
