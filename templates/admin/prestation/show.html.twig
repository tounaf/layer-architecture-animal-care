{% extends 'admin/layout.html.twig' %}

{% block title %}Détails de la Prestation{% endblock %}

{% block body %}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">

            <div class="col">
                <h2 class="page-title">
                    Prestation du {{ prestation.dateRealisation|date('d/m/Y') }}
                </h2>
            </div>

            <div class="col-auto ms-auto">
                <a href="{{ path('admin_prestation_index') }}" class="btn btn-info">
                    Retour à la liste
                </a>
            </div>

        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">

        <div class="row row-cards">

            <!-- ================= LEFT SIDE ================= -->
            <div class="col-md-4">

                <!-- RESUME -->
                <div class="card shadow-sm">
                    <div class="card-body text-center">

                        <h3 class="mb-1">{{ service.nom }}</h3>
                        <div class="text-muted">Service effectué</div>

                        <hr>

                        <div class="h1 text-">
                            {{ prestation.coutTotal }} Ariary
                        </div>

                        <div class="text-muted mb-3">Coût total</div>

                        <span class="badge bg-info px-3 py-2">
                            {{ prestation.statut }}
                        </span>

                    </div>
                </div>

                <!-- CLIENT & ANIMAL -->
                <div class="card mt-3 shadow-sm">
                    <div class="card-header">
                        <h3 class="card-title">Client & Animal</h3>
                    </div>

                    <div class="card-body">

                        <div class="mb-3">
                            <div class="text-muted small">Client</div>
                            <div class="fw-bold">{{ clientInfo }}</div>
                        </div>

                        <div>
                            <div class="text-muted small">Animal</div>
                            <div class="fw-bold">{{ animalInfo }}</div>
                        </div>

                    </div>
                </div>

                <!-- RENDEZ-VOUS -->
                <div class="card mt-3 shadow-sm">
                    <div class="card-header">
                        <h3 class="card-title">Rendez-vous</h3>
                    </div>

                    <div class="card-body">

                        {% if rdv %}

                            <div class="mb-2">
                                <div class="text-muted small">Date</div>
                                <div class="fw-bold">
                                    {{ rdv.dateRdv|date('d/m/Y') }}
                                </div>
                            </div>

                            <div>
                                <div class="text-muted small">Horaire</div>
                                <div class="fw-bold">
                                    {{ rdv.plageHoraire.debut }} - {{ rdv.plageHoraire.fin }}
                                </div>
                            </div>

                        {% else %}
                            <span class="text-muted">Aucun rendez-vous</span>
                        {% endif %}

                    </div>
                </div>

            </div>

            <!-- ================= RIGHT SIDE ================= -->
            <div class="col-md-8">

                <div class="card shadow-sm">

                    <div class="card-header">
                        <h3 class="card-title">Détails spécifiques</h3>
                    </div>

                    <div class="card-body">

                        <div class="row">

                            {% for valeur in prestation.valeursChamps %}

                                {% set currentChamp = null %}

                                {% for c in champs %}
                                    {% if c.id == valeur.serviceChampId %}
                                        {% set currentChamp = c %}
                                    {% endif %}
                                {% endfor %}

                                <div class="col-md-6 mb-3">

                                    <div class="border rounded p-3 h-100">

                                        <div class="text-muted small">
                                            {{ currentChamp ? currentChamp.nom : 'Champ #' ~ valeur.serviceChampId }}
                                        </div>

                                        <div class="mt-1 fw-bold">

                                            {% if valeur.typeValeur == 'fichier' %}
                                                <a href="{{ valeur.valeur }}" target="_blank">
                                                    📎 Voir le fichier
                                                </a>
                                            {% else %}
                                                {{ valeur.valeur }}
                                            {% endif %}

                                        </div>

                                    </div>

                                </div>

                            {% endfor %}

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>

{% endblock %}