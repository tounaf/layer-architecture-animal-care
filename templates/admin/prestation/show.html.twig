{% extends 'admin/layout.html.twig' %}

{% block title %}Détails de la Prestation{% endblock %}

{% block body %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Prestation du {{ prestation.dateRealisation|date('d/m/Y') }}</h2>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="row row-cards">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <div class="datagrid">
                            <div class="datagrid-item">
                                <div class="datagrid-title">Service effectué</div>
                                <div class="datagrid-content">{{ service.nom }}</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Coût total</div>
                                <div class="datagrid-content">{{ prestation.coutTotal }} EUR</div>
                            </div>
                            <div class="datagrid-item">
                                <div class="datagrid-title">Statut</div>
                                <div class="datagrid-content"><span class="status status-green">{{ prestation.statut }}</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header"><h3 class="card-title">Détails spécifiques</h3></div>
                    <div class="card-body">
                        <div class="datagrid">
                            {% for valeur in prestation.valeursChamps %}
                                <div class="datagrid-item">
                                    <div class="datagrid-title">Champ ID: {{ valeur.serviceChampId }}</div>
                                    <div class="datagrid-content">
                                        {% if valeur.typeValeur == 'fichier' %}
                                            <a href="{{ valeur.valeur }}" target="_blank" class="btn btn-sm btn-white">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M14 3v4a1 1 0 0 0 1 1h4" /><path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" /><path d="M12 11v6" /><path d="M9.5 13.5l2.5 -2.5l2.5 2.5" /></svg>
                                                Voir le document
                                            </a>
                                        {% else %}
                                            {{ valeur.valeur }}
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
