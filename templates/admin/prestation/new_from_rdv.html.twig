{% extends 'admin/layout.html.twig' %}

{% block title %}Valider la prestation{% endblock %}

{% block body %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Validation de la prestation</h2>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        <form method="post" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ csrf_token('realiser_prestation') }}">

            <div class="card">
                <div class="card-header"><h3 class="card-title">Informations générales</h3></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Coût total (Ar)</label>
                        <input type="number" step="0.01" name="coutTotal" class="form-control" required>
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header"><h3 class="card-title">Médicaments prescrits</h3></div>
                <div class="card-body">
                    <div id="prescriptions-container">
                        <div class="row mb-2 prescription-row">
                            <div class="col-md-8">
                                <select name="med_ids[]" class="form-select">
                                    <option value="">-- Choisir un médicament --</option>
                                    {% for med in medicaments %}
                                        <option value="{{ med.id }}">{{ med.nom }} (Stock: {{ med.stockActuel }})</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-3">
                                <input type="number" name="med_qtys[]" class="form-control" placeholder="Qté">
                            </div>
                            <div class="col-md-1">
                                <button type="button" class="btn btn-icon btn-danger remove-prescription"><i class="ti ti-trash"></i></button>
                            </div>
                        </div>
                    </div>
                    <button type="button" id="add-prescription" class="btn btn-sm btn-outline-primary mt-2">
                        <i class="ti ti-plus me-1"></i> Ajouter un autre médicament
                    </button>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header"><h3 class="card-title">Champs spécifiques au service</h3></div>
                <div class="card-body">
                    {% for champ in champs %}
                        <div class="mb-3">
                            <label class="form-label">
                                {{ champ.nom }}
                                {% if champ.isObligatoireGlobal %}<span class="text-danger">*</span>{% endif %}
                            </label>
                            {% if champ.typeChamp == 'textarea' %}
                                <textarea name="champ_{{ champ.id }}" class="form-control" {% if champ.isObligatoireGlobal %}required{% endif %}></textarea>
                            {% elseif champ.typeChamp == 'file' %}
                                <input type="file" name="champ_{{ champ.id }}" class="form-control" {% if champ.isObligatoireGlobal %}required{% endif %}>
                            {% elseif champ.typeChamp == 'date' %}
                                <input type="date" name="champ_{{ champ.id }}" class="form-control" {% if champ.isObligatoireGlobal %}required{% endif %}>
                            {% elseif champ.typeChamp == 'datetime' %}
                                <input type="datetime-local" name="champ_{{ champ.id }}" class="form-control" {% if champ.isObligatoireGlobal %}required{% endif %}>
                            {% else %}
                                <input type="text" name="champ_{{ champ.id }}" class="form-control" {% if champ.isObligatoireGlobal %}required{% endif %}>
                            {% endif %}
                            <div class="form-hint">{{ champ.description }}</div>
                        </div>
                    {% endfor %}
                </div>
                <div class="card-footer text-end">
                    <button type="submit" class="btn btn-primary">Enregistrer la prestation</button>
                </div>
            </div>
        </form>
    </div>
</div>
{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const container = document.getElementById('prescriptions-container');
    const addButton = document.getElementById('add-prescription');

    addButton.addEventListener('click', function() {
        const firstRow = container.querySelector('.prescription-row');
        const newRow = firstRow.cloneNode(true);
        newRow.querySelector('select').value = '';
        newRow.querySelector('input').value = '';
        container.appendChild(newRow);
    });

    container.addEventListener('click', function(e) {
        if (e.target.closest('.remove-prescription')) {
            const rows = container.querySelectorAll('.prescription-row');
            if (rows.length > 1) {
                e.target.closest('.prescription-row').remove();
            } else {
                const row = rows[0];
                row.querySelector('select').value = '';
                row.querySelector('input').value = '';
            }
        }
    });
});
</script>
{% endblock %}
{% endblock %}
