{% extends 'admin/layout.html.twig' %}

{% block title %}Gestion des Rendez-vous{% endblock %}

{% block body %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Rendez-vous</h2>
            </div>
            {# <div class="col-auto ms-auto">
                <a href="{{ path('admin_rendezvous_new') }}" class="btn btn-primary">
                    Nouveau RDV
                </a>
            </div> #}
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Heure</th>
                            <th>Client</th>
                            <th>Animal</th>
                            <th>Statut</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for rdv in rendezVousList %}
                            <tr>
                                <td>
                                    {{ rdv.dateRdv|date('d/m/Y') }}
                                </td>
                                <td>
                                    {{ rdv.plageHoraire.debut }} - {{ rdv.plageHoraire.fin }}
                                </td>
                                <td>
                                    {{ rdv.clientId }}
                                </td>
                                <td>
                                    {{ rdv.animalId }}
                                </td>
                                <td>
                                    {% if rdv.statut.value == 'en_attente' %}
                                        <span class="badge bg-warning">En attente</span>
                                    {% elseif rdv.statut.value == 'confirme' %}
                                        <span class="badge bg-success">Confirmé</span>
                                    {% elseif rdv.statut.value == 'annule' %}
                                        <span class="badge bg-danger">Annulé</span>
                                    {% elseif rdv.statut.value == 'termine' %}
                                        <span class="badge bg-primary">Terminé</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="btn-list flex-nowrap">
                                        
                                        {% if rdv.statut.value == 'en_attente' %}
                                            <form method="post" action="{{ path('admin_rendezvous_confirm', {id: rdv.id}) }}" class="d-inline">
                                                <button class="btn btn-success btn-sm">
                                                    <i class="ti ti-check"></i> Confirmer
                                                </button>
                                            </form>

                                            <form method="post" action="{{ path('admin_rendezvous_cancel', {id: rdv.id}) }}" class="d-inline" onsubmit="return confirm('Annuler ce rendez-vous ?');">
                                                <button class="btn btn-danger btn-sm">
                                                    <i class="ti ti-x"></i> Annuler
                                                </button>
                                            </form>

                                            <button class="btn btn-info btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#reschedule-{{ rdv.id }}">
                                                <i class="ti ti-calendar-time"></i> Reporter
                                            </button>
                                        {% endif %}

                                        {% if rdv.statut.value == 'confirme' %}
                                            <a href="{{ path('admin_prestation_new_from_rdv', {rdvId: rdv.id}) }}"
                                            class="btn btn-primary btn-sm">
                                                <i class="ti ti-plus"></i> Créer prestation
                                            </a>

                                            <button class="btn btn-info btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#reschedule-{{ rdv.id }}">
                                                <i class="ti ti-calendar-time"></i> Reporter
                                            </button>

                                            <form method="post" action="{{ path('admin_rendezvous_cancel', {id: rdv.id}) }}" class="d-inline" onsubmit="return confirm('Annuler ce rendez-vous confirmé ?');">
                                                <button class="btn btn-outline-danger btn-sm">
                                                    Annuler
                                                </button>
                                            </form>
                                        {% endif %}

                                    </div>

                                    {# Formulaire de report (caché par défaut) #}
                                    <div class="collapse mt-2" id="reschedule-{{ rdv.id }}">
                                        <div class="card card-body">
                                            <form method="post" action="{{ path('admin_rendezvous_reschedule', {id: rdv.id}) }}">
                                                <div class="mb-2">
                                                    <label class="form-label">Nouvelle date</label>
                                                    <input type="date" name="date" class="form-control form-control-sm" required value="{{ rdv.dateRdv|date('Y-m-d') }}">
                                                </div>
                                                <div class="mb-2">
                                                    <label class="form-label">Nouvelle heure</label>
                                                    <input type="time" name="heure" class="form-control form-control-sm" required value="{{ rdv.plageHoraire.debut }}">
                                                </div>
                                                <button type="submit" class="btn btn-primary btn-sm w-100">Confirmer le report</button>
                                            </form>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center">
                                    Aucun rendez-vous trouvé
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}