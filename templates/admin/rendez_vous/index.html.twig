{% extends 'admin/layout.html.twig' %}

{% block title %}Gestion des Rendez-vous{% endblock %}

{% block body %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h2 class="page-title">Rendez-vous</h2>
            </div>
        </div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Heure</th>
                            <th>Client</th>
                            <th>Animal</th>
                            <th>Statut</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in enhancedRdvList %}
                            {% set rdv = item.rdv %}
                            <tr>
                                <td>
                                    {{ rdv.dateRdv|date('d/m/Y') }}
                                </td>
                                <td>
                                    {{ rdv.plageHoraire.debut }} - {{ rdv.plageHoraire.fin }}
                                </td>
                                <td>
                                    {{ item.clientName }}
                                </td>
                                <td>
                                    {{ item.animalName }}
                                </td>
                                <td>
                                    {% if rdv.statut.value == 'en_attente' %}
                                        <span class="badge bg-warning">En attente</span>
                                    {% elseif rdv.statut.value == 'confirme' %}
                                        <span class="badge bg-success">Confirmé</span>
                                    {% elseif rdv.statut.value == 'annule' %}
                                        <span class="badge bg-danger">Annulé</span>
                                    {% elseif rdv.statut.value == 'termine' %}
                                        <span class="badge bg-primary">Terminé</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="btn-list flex-nowrap">
                                        {% if rdv.statut.value == 'en_attente' %}
                                            <a href="{{ path('admin_prestation_new_from_rdv', {rdvId: rdv.id}) }}"
                                            class="btn btn-primary btn-sm">
                                                Créer prestation
                                            </a>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center">
                                    Aucun rendez-vous trouvé
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
