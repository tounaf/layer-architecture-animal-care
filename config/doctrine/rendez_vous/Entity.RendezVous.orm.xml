<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Domain\RendezVous\Entity\RendezVous" table="rendez_vous" repository-class="Infrastructure\Persistence\Doctrine\Repository\DoctrineRendezVousRepository">
        <id name="id" type="rendez_vous_id" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="clientId" type="client_id" column="client_id"/>
        <field name="animalId" type="animal_id" column="animal_id"/>
        <field name="prestataireId" type="prestataire_id" column="prestataire_id"/>
        <field name="serviceProposeId" type="service_propose_id" column="service_propose_id"/>
        <field name="dateRdv" type="date_immutable" column="date_rdv"/>
        <field name="statut" type="string" enum-type="Domain\RendezVous\Enum\StatutRendezVous"/>
        <field name="commentaires" type="text" nullable="true"/>

        <embedded name="plageHoraire" class="Domain\RendezVous\ValueObject\TimeRange" use-column-prefix="false"/>
    </entity>

</doctrine-mapping>
