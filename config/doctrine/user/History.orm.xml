<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Domain\User\Entity\History" table="history">
        <id name="id" type="history_id" column="id" />
        <field name="ip" length="45" />
        <field name="tableName" length="255" column="table_name" />
        <field name="resourceId" length="255" column="resource_id" />
        <field name="actionDate" type="datetime_immutable" column="action_date" />

        <field name="userId" type="user_id" column="user_id" />
        <field name="actionId" type="action_id" column="action_id" />
    </entity>

</doctrine-mapping>
