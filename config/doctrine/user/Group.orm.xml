<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Domain\User\Entity\Group" table="user_group_definitions">
        <id name="id" type="group_id" column="id" />
        <field name="groupName" length="255" column="group_name" />
        <field name="createdAt" type="datetime_immutable" column="created_at" />
        <field name="updatedAt" type="datetime_immutable" column="updated_at" nullable="true" />

        <many-to-many field="rights" target-entity="Domain\User\Entity\Right">
            <join-table name="group_rights">
                <join-columns>
                    <join-column name="group_id" referenced-column-name="id" />
                </join-columns>
                <inverse-join-columns>
                    <join-column name="right_id" referenced-column-name="id" />
                </inverse-join-columns>
            </join-table>
        </many-to-many>

        <many-to-many field="profiles" target-entity="Domain\User\Entity\Profile">
            <join-table name="group_profiles">
                <join-columns>
                    <join-column name="group_id" referenced-column-name="id" />
                </join-columns>
                <inverse-join-columns>
                    <join-column name="profile_id" referenced-column-name="id" />
                </inverse-join-columns>
            </join-table>
        </many-to-many>
    </entity>

</doctrine-mapping>
