<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Domain\Service\Entity\ServiceCategorie" table="service_categorie">
        <id name="id" type="service_categorie_id" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="nom" type="string"/>
        <field name="description" type="text" nullable="true"/>
        <field name="icone" type="string" nullable="true"/>
        <field name="ordreAffichage" type="integer" column="ordre_affichage"/>
        <field name="actif" type="boolean"/>
    </entity>

</doctrine-mapping>
