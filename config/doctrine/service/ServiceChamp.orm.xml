<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Domain\Service\Entity\ServiceChamp" table="service_champ">
        <id name="id" type="service_champ_id" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="nom" type="string"/>
        <field name="typeChamp" type="string" column="type_champ"/>
        <field name="description" type="text" nullable="true"/>
        <field name="obligatoireGlobal" type="boolean" column="obligatoire_global"/>
    </entity>

</doctrine-mapping>
