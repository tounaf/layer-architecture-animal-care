<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Domain\Service\Entity\Service" table="service">
        <id name="id" type="service_id" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="nom" type="string"/>
        <field name="code" type="string" length="50" unique="true"/>
        <field name="description" type="text" nullable="true"/>
        <field name="dureeDefaultMinutes" type="integer" column="duree_default_minutes"/>
        <field name="necessiteAcompteDefault" type="boolean" column="necessite_acompte_default"/>
        <field name="actif" type="boolean"/>

        <many-to-one field="categorie" target-entity="Domain\Service\Entity\ServiceCategorie">
            <join-column name="categorie_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>

        <embedded name="tarif" class="Domain\Service\Entity\Tarif" use-column-prefix="false"/>
    </entity>

</doctrine-mapping>
