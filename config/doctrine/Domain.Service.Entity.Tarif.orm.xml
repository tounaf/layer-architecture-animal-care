<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <embeddable name="Domain\Service\Entity\Tarif">
        <field name="montant" type="float" column="montant"/>
        <field name="devise" type="string" length="3" column="devise"/>
        <field name="dateApplication" type="datetime_immutable" column="date_application"/>
    </embeddable>

</doctrine-mapping>
