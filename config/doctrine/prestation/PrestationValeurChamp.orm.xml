<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Domain\Prestation\Entity\PrestationValeurChamp" table="prestation_valeur_champ">
        <id name="prestationId" type="prestation_id" column="prestation_id"/>
        <id name="serviceChampId" type="service_champ_id" column="service_champ_id"/>

        <field name="valeur" type="text" nullable="true"/>
        <field name="typeValeur" type="string" column="type_valeur"/>
        <field name="documentId" type="document_id" column="document_id" nullable="true"/>
    </entity>

</doctrine-mapping>
