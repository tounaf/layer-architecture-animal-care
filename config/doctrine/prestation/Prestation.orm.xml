<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Domain\Prestation\Entity\Prestation" table="prestation">
        <id name="id" type="prestation_id" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="rendezVousId" type="rendez_vous_id" column="rendez_vous_id"/>
        <field name="serviceProposeId" type="service_propose_id" column="service_propose_id"/>
        <field name="dateRealisation" type="datetime_immutable" column="date_realisation"/>
        <field name="coutTotal" type="float" column="cout_total"/>
        <field name="statut" type="string"/>

        <one-to-many field="valeursChamps" target-entity="Domain\Prestation\Entity\PrestationValeurChamp" mapped-by="prestationId">
             <cascade>
                <cascade-all/>
            </cascade>
        </one-to-many>
    </entity>

</doctrine-mapping>
